{
  "name": "naughty-list",
  "version": "1.0.0",
  "private": true,
  "description": "The Naughty List: a Christmas imp-trapping browser game with no hunt timer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-content": "tsx scripts/check-content.ts",
    "simulate": "tsx scripts/simulate.ts",
    "play": "npm run build && npm start",
    "art": "tsx scripts/art/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.7",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
